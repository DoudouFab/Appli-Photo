rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Sole administrator authorized to approve or revoke colleague access
    function isAdmin() {
      return isVerifiedUser() &&
        'email' in request.auth.token &&
        request.auth.token.email is string &&
        request.auth.token.email.lower() == 'pirquinfabien@gmail.com';
    }

    function callerPreauthDocId() {
      return request.auth.token.email.lower().replace('[^a-z0-9-]', '_');
    }

    function isPreauthorizedCaller() {
      return isSignedIn() &&
        'email' in request.auth.token &&
        request.auth.token.email is string &&
        callerPreauthDocId().size() >= 3 &&
        callerPreauthDocId().size() <= 128 &&
        exists(/databases/$(database)/documents/preauthorized_emails/$(callerPreauthDocId())) &&
        get(/databases/$(database)/documents/preauthorized_emails/$(callerPreauthDocId())).data.email.lower() == request.auth.token.email.lower();
    }

    function isValidAccessUser(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'role', 'status', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'status', 'deviceHint', 'note', 'createdAt', 'updatedAt']) &&
        data.uid is string && data.uid == userId && isValidId(data.uid) &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 254 &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120 &&
        data.role in ['admin', 'user'] &&
        data.status in ['pending', 'approved', 'revoked'] &&
        (!('deviceHint' in data) || (data.deviceHint is string && data.deviceHint.size() <= 120)) &&
        (!('note' in data) || (data.note is string && data.note.size() <= 200)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidPreauthorizedEmail(data, emailId) {
      return data.keys().hasAll(['id', 'email', 'createdBy', 'createdAt']) &&
        data.keys().hasOnly(['id', 'email', 'note', 'createdBy', 'createdAt']) &&
        data.id is string && data.id == emailId && isValidId(data.id) &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 254 &&
        (!('note' in data) || (data.note is string && data.note.size() <= 200)) &&
        data.createdBy is string && data.createdBy == request.auth.uid && isValidId(data.createdBy) &&
        data.createdAt is timestamp;
    }

    match /access_users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();

      allow create: if isSignedIn() &&
        isValidId(userId) &&
        isValidAccessUser(incoming(), userId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time && (
          (isAdmin() && (
            (isOwner(userId) && incoming().role == 'admin' && incoming().status == 'approved') ||
            !isOwner(userId)
          )) ||
          (
            isOwner(userId) &&
            'email' in request.auth.token &&
            request.auth.token.email is string &&
            incoming().email.lower() == request.auth.token.email.lower() &&
            incoming().role == 'user' &&
            (incoming().status == 'pending' || (incoming().status == 'approved' && isPreauthorizedCaller())) &&
            !('note' in incoming())
          )
        );

      allow update: if isSignedIn() &&
        isValidId(userId) &&
        isValidAccessUser(incoming(), userId) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          (
            isAdmin() &&
            incoming().email == existing().email &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'role', 'note', 'displayName', 'deviceHint', 'updatedAt'])
          ) ||
          (
            isOwner(userId) &&
            incoming().email == existing().email &&
            incoming().role == existing().role &&
            incoming().status == existing().status &&
            incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'deviceHint', 'updatedAt'])
          )
        );

      allow delete: if isAdmin() && isValidId(userId);
    }

    match /preauthorized_emails/{emailId} {
      allow get: if isAdmin() || (
        isSignedIn() &&
        isValidId(emailId) &&
        'email' in request.auth.token &&
        request.auth.token.email is string &&
        emailId == callerPreauthDocId()
      );
      allow list: if isAdmin();
      allow create: if isAdmin() &&
        isValidId(emailId) &&
        isValidPreauthorizedEmail(incoming(), emailId) &&
        incoming().createdAt == request.time;
      allow update: if isAdmin() &&
        isValidId(emailId) &&
        isValidPreauthorizedEmail(incoming(), emailId) &&
        incoming().id == existing().id &&
        incoming().email == existing().email &&
        incoming().createdBy == existing().createdBy &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['note']);
      allow delete: if isAdmin() && isValidId(emailId);
    }
  }
}
